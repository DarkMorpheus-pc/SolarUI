{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/blazeos/ascii-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " › ",
    "color": {
      "keys": "38;2;212;212;216",
      "title": "38;2;229;77;46"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS      "
    },
    {
      "type": "kernel",
      "key": "Kernel  "
    },
    {
      "type": "uptime",
      "key": "Uptime  "
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "shell",
      "key": "Shell   "
    },
    {
      "type": "de",
      "key": "DE      ",
      "format": "SolarUI"
    },
    {
      "type": "wm",
      "key": "WM      ",
      "format": "Niri Wayland"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "cpu",
      "key": "CPU     "
    },
    {
      "type": "gpu",
      "key": "GPU     "
    },
    {
      "type": "memory",
      "key": "Memory  "
    },
    {
      "type": "disk",
      "key": "Disk    "
    },
    "break",
    "colors"
  ]
}
