// BlazeOS SolarUI - Hybrid KDE + Niri & Noctalia Desktop Configuration
// Flawless combination of:
// - Top: Noctalia Bar (all CachyOS features, control center, audio, visualizer, calendar)
// - Center: KDE-style Floating & Tiling Windows with CachyOS Spring Physics & Kawase Blur
// - Bottom: SolarUI KDE-style Taskbar (Start menu, open window tasks, vector SVGs, zero emojis)

spawn-at-startup "solar-shell" "autostart"
prefer-no-csd

// Suppress unbranded raw compositor hotkey overlay in favor of SolarUI Welcome HUD
hotkey-overlay {
    skip-at-startup
}

input {
    keyboard {
        xkb {
            layout "tr,us"
            options "grp:alt_shift_toggle"
        }
    }

    touchpad {
        tap
        dwt
        natural-scroll
        accel-speed 0.2
    }

    mouse {
        accel-speed 0.0
    }
}

output "eDP-1" {
    scale 1.0
    variable-refresh-rate on-demand=true
}

output "Virtual-1" {
    scale 1.0
}

layout {
    gaps 14
    center-focused-column "never"
    background-color "transparent" // Transparent so Noctalia wallpaper on backdrop is visible

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-gradient from="#38bdf8" to="#818cf8" angle=135
        inactive-color "#1e293b"
    }

    border {
        off
    }

    struts {
        top 10
        left 10
        right 10
        bottom 52 // Reserved space for KDE taskbar + safety margin
    }
}

// ColorOS 17 Living Flow / Aurora Elastic-Damped Spring Physics
animations {
    workspace-switch {
        spring damping-ratio=0.90 stiffness=840 epsilon=0.0001
    }
    window-open {
        duration-ms 230
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 190
        curve "ease-out-cubic"
    }
    horizontal-view-movement {
        spring damping-ratio=0.90 stiffness=820 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.88 stiffness=780 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.92 stiffness=880 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.72 stiffness=1000 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 260
        curve "ease-out-expo"
    }
    overview-open-close {
        spring damping-ratio=0.90 stiffness=850 epsilon=0.0001
    }
}

// Window Geometries & Glassmorphism Blur (KDE Plasma Style Floating Windows)
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
    open-floating true
}

window-rule {
    background-effect {
        blur true
        xray false
    }
}

// Installer & Dialog window rules: Center Solar Installer / Anaconda and prevent full-screen corner trapping
window-rule {
    match app-id=r#"^(solar-installer-gui|liveinst|anaconda|org\.fedoraproject\.Anaconda.*|Anaconda)$"#
    open-floating true
    default-column-width { fixed 920; }
    default-window-height { fixed 640; }
    geometry-corner-radius 20
    clip-to-geometry true
}

// Adaptive Sync (VRR) for Fullscreen Games & Steam Proton
window-rule {
    match app-id=r#"^(steam_app_.*|gamescope|cs2|dota2|beamng.*|solar-gamezone)$"#
    variable-refresh-rate true
}

// Default primary workspace and dedicated background workspace for parked/minimized windows
workspace "1"
workspace "background"

// Blaze Setup Assistant Window Rule
window-rule {
    match app-id=r#"(org\.blazeos\.setup|blaze-setup)"#
    open-floating true
    open-focused true
    open-fullscreen true
}

window-rule {
    match title=r#"^Blaze Setup Assistant"#
    open-floating true
    open-focused true
    open-fullscreen true
}

// SolarUI Windows 11 Snap Layouts HUD Window Rule
window-rule {
    match app-id="^solar-snap$"
    open-floating true
    default-floating-position x=0 y=54 relative-to="top"
    default-column-width { fixed 440; }
    default-window-height { fixed 260; }
    geometry-corner-radius 16
    clip-to-geometry true
}

// Live Installer Window Rule (Floating Centered, 82% screen proportion)
window-rule {
    match app-id="^(liveinst|firefox)$"
    open-floating true
    default-column-width { proportion 0.82; }
    default-window-height { proportion 0.82; }
    geometry-corner-radius 16
    clip-to-geometry true
}

// Dialog & System Utility Windows Rule (Open Floating)
window-rule {
    match is-floating=true
    geometry-corner-radius 16
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^(org\.gnome\.FileRoller|org\.gnome\.NautilusPreviewer|polkit-gnome-authentication-agent-1|pavucontrol)$"#
    open-floating true
}

// BlazeOS Control Center & Native Tools
window-rule {
    match app-id=r#"^(org\.blazeos\.control|FireHub|firehub|blazeos-welcome)$"#
    open-floating true
    default-column-width { proportion 0.75; }
    default-window-height { proportion 0.80; }
    geometry-corner-radius 16
    clip-to-geometry true
}

// SolarUI KDE Taskbar Window Rule
window-rule {
    match app-id="solar-shell"
    open-floating true
    default-floating-position x=0 y=0 relative-to="bottom-left"
    default-column-width { proportion 1.0; }
    default-window-height { fixed 44; }
}

// Noctalia Settings Window Rule
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// SolarUI Settings Window Rule
window-rule {
    match app-id="^solar-settings$"
    open-floating true
    default-column-width { fixed 1020; }
    default-window-height { fixed 620; }
    geometry-corner-radius 20
    clip-to-geometry true
}

// Alacritty & Wayland Terminal Window Rule (Wide enough for zero Fastfetch line wrapping)
window-rule {
    match app-id=r#"^(Alacritty|org\.Alacritty|foot|kitty)$"#
    open-floating true
    default-column-width { fixed 920; }
    default-window-height { fixed 560; }
    geometry-corner-radius 20
    clip-to-geometry true
}

// SolarUI Welcome & Shortcuts Window Rule
window-rule {
    match app-id="^solar-welcome$"
    open-floating true
    default-column-width { fixed 750; }
    default-window-height { fixed 590; }
    geometry-corner-radius 20
    clip-to-geometry true
}

// SolarUI Omnibar (Raycast / Spotlight Command Hub)
window-rule {
    match app-id="^solar-omnibar$"
    open-floating true
    default-column-width { fixed 700; }
    default-window-height { fixed 470; }
    geometry-corner-radius 22
    clip-to-geometry true
}

// Blaze GameZone Fullscreen Gaming Shell
window-rule {
    match app-id="^solar-gamezone$"
    open-fullscreen true
    geometry-corner-radius 0
}

// Steam & Dialog Window Rules
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

// SolarUI Google Pixel Clock Widget
window-rule {
    match app-id="^solar-clock$"
    open-floating true
    open-focused false
    default-floating-position x=0 y=70 relative-to="top"
    default-column-width { fixed 460; }
    default-window-height { fixed 280; }
    geometry-corner-radius 0
    clip-to-geometry false
    background-effect {
        blur false
    }
}

// Layer Shell Rules for Noctalia
layer-rule {
    match namespace="^noctalia-(desktop-widget|wallpaper).*"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

binds {
    // ── Workspace & Window Navigation ──────────────────────────────
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }

    // ── Window Actions (KDE Habits) ────────────────────────────────
    Mod+Q     { close-window; }
    Alt+F4    { close-window; }
    Mod+Y     { spawn-sh "solar-shell minimize"; }
    Mod+Ctrl+Down { spawn-sh "solar-shell minimize"; }
    Mod+T     { toggle-window-floating; }
    Mod+F     { toggle-window-floating; }
    Mod+M     { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Z     { spawn-sh "solar-shell snap"; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+Tab   { toggle-overview; }
    Mod+D     { spawn "solar-shell" "route" "dashboard"; }

    // ── SolarUI Panels & Settings (Routed via SolarSurfaceRouter) ──
    Mod+Space           { spawn "solar-shell" "omnibar"; }
    Mod+G               { spawn "solar-shell" "gamezone"; }
    Mod+Alt+K           { spawn "solar-shell" "easter-egg" "konami"; }
    Mod+S               { spawn "solar-shell" "route" "control-center"; }
    Mod+I               { spawn "solar-shell" "route" "settings"; }
    Mod+Comma           { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Shift+S         { spawn "solar-shell" "route" "settings"; }
    Mod+Shift+Q         { spawn "solar-shell" "route" "session"; }
    Mod+Alt+R           { spawn "solar-shell" "supervisor"; }
    Mod+Alt+S           { spawn "solar-shell" "settings"; }
    Mod+F1              { spawn "solar-shell" "welcome"; }
    Mod+Shift+Escape    { spawn "solar-shell" "welcome"; }

    // ── Quick App Launchers ────────────────────────────────────────
    Mod+Return { spawn "alacritty"; }
    Ctrl+Alt+T { spawn "alacritty"; }
    Mod+H      { spawn "firehub"; }
    Mod+E      { spawn "nautilus"; }
    Mod+B      { spawn "google-chrome-stable"; }

    // ── Audio & Media Keys ─────────────────────────────────────────
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    // ── Brightness Keys ────────────────────────────────────────────
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // ── Screenshots ────────────────────────────────────────────────
    F10       { spawn "sh" "-c" "grim -g \"$(slurp)\" - | satty --filename -"; }
    Print     { spawn "sh" "-c" "grim -g \"$(slurp)\" - | satty --filename -"; }
    Alt+Print { spawn "sh" "-c" "grim - | satty --filename -"; }

    // ── Session ────────────────────────────────────────────────────
    Mod+Shift+E { quit skip-confirmation=true; }
    Ctrl+Alt+Delete { quit skip-confirmation=true; }
    Mod+L       { spawn "solar-lock"; }
}
